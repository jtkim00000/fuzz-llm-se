# Open WebUI listens on http://localhost:3000 by default.
OPEN_WEBUI_PORT=3000

# Point this at the future precision-aware gateway or a vLLM OpenAI endpoint.
# The /v1 suffix is required by Open WebUI's OpenAI-compatible connection.
OPENAI_API_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=
AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=30

# Local router-test facades. Both forward to the same model on port 8000.
# The FP8 facade is explicitly simulated; its actual KV cache remains BF16.
# These root URLs omit /v1 so clients can also reach /health and /worker-info.
BF16_WORKER_URL=http://127.0.0.1:8001
FP8_WORKER_URL=http://127.0.0.1:8002
