version: v4

volumes:
  model:
    name: qwen25-awq

services:
  vllm:
    persist: true
    image:
      uri: docker://vllm/vllm-openai:v0.28.0
    mounts:
      /data:
        volume: model
    resource:
      cpu:
        cores: 8
      memory:
        size: 34GiB
      devices:
        nvidia.com/gpu: 1
    script: |
      #!/bin/sh
      set -eu
      exec vllm serve /data/qwen--qwen2.5-coder-7b-instruct-awq \
        --served-model-name Qwen/Qwen2.5-Coder-7B-Instruct-AWQ \
        --tensor-parallel-size 1 \
        --max-model-len 32768 \
        --gpu-memory-utilization 0.8 \
        --host 0.0.0.0 \
        --port 18000 \
        --enable-auto-tool-choice \
        --tool-call-parser hermes \
        --trust-remote-code
    network:
      ports:
        - name: api
          port: 18000
          protocol: tcp
      endpoints:
        - name: api
          port-name: api
          type: subdomain
          protocol: http
          scope: user
